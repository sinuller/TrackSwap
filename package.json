{
  "name": "trackswap",
  "private": true,
  "version": "1.0.0",
  "description": "A/B audio comparison in the browser: seamless switching, loudness matching, blind & ABX tests, quality analysis.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "icons": "node scripts/gen-icons.mjs",
    "test": "vitest run",
    "verify": "npm run check && npm run test && npm run build"
  },
  "dependencies": {
    "@ffmpeg/ffmpeg": "^0.12.15",
    "music-metadata": "^12.2.3"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tsconfig/svelte": "^5.0.8",
    "node-web-audio-api": "^2.2.0",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.7",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22"
  }
}
